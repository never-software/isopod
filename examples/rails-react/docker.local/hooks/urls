#!/bin/bash
# hooks/urls — Output service URLs for display after create/up
#
# Called by: isopod create, isopod up
# Env: FEATURE_NAME — the pod name (used as hostname with OrbStack)
#
# Reads services.json (the stack's service manifest) so URLs never drift from
# the rest of the service config. Emits one line per service that has a
# urlLabel + port, tab-separated: "label<TAB>url".

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MANIFEST="$SCRIPT_DIR/../services.json"

[ -f "$MANIFEST" ] || exit 0
command -v jq >/dev/null 2>&1 || exit 0

jq -r --arg host "${FEATURE_NAME:-localhost}" '
  .services[]
  | select(.urlLabel != null and .port != null)
  | [ .urlLabel,
      ((.protocol // "http") + "://" + $host + ".orb.local:" + (.port | tostring)) ]
  | @tsv' "$MANIFEST"
