# Qdrant vector DB. With a localhost URL, the indexer daemon auto-creates and
# manages a local `isopod-qdrant` Docker container — no setup needed. The
# unsecured local instance ignores the API key (any non-empty value works).
# To use a remote/cloud Qdrant instead, set its URL and real API key.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=local
OPENAI_API_KEY=sk-your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536
